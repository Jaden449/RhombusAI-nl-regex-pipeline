# Copy this file to .env and fill in your own values.
# .env is gitignored -- never commit real secrets.

DJANGO_SECRET_KEY=change-me-to-something-random
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

POSTGRES_DB=rhombus
POSTGRES_USER=rhombus
POSTGRES_PASSWORD=rhombus

# Optional: without this, the app still works using a small rule-based
# fallback pattern library (email, phone, url, date, zip, ipv4, hashtag,
# currency) so you can demo it offline. Add a real key for genuine LLM-driven
# natural language -> regex conversion.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

SPARK_SHUFFLE_PARTITIONS=8
